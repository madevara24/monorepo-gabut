# Copy this file to .env and edit the values.
# A command line flag always wins over a value in this file.
# A value in this file always wins over the built-in default.

BROKER=redis
PAYLOAD_FILE=message.json
COUNT=5
INTERVAL=1s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MODE=streams
REDIS_STREAM=demo
REDIS_GROUP=demo-group

RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_QUEUE=demo

KAFKA_FLAVOR=kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=demo
KAFKA_GROUP=demo-group
